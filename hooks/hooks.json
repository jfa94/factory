{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/dist/factory-hook.js write-protection",
                        "timeout": 5,
                        "statusMessage": "Checking TCB write-protection"
                    },
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/dist/factory-hook.js branch-protection",
                        "timeout": 5,
                        "statusMessage": "Checking branch protection"
                    },
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/dist/factory-hook.js secret-guard",
                        "timeout": 15,
                        "statusMessage": "Scanning staged changes for secrets"
                    },
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/dist/factory-hook.js feature-guards",
                        "timeout": 10,
                        "statusMessage": "Checking feature scope and publication ownership"
                    }
                ]
            },
            {
                "matcher": "^(Edit|Write|MultiEdit)$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/dist/factory-hook.js write-protection",
                        "timeout": 5,
                        "statusMessage": "Checking TCB write-protection"
                    },
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/dist/factory-hook.js feature-guards",
                        "timeout": 10,
                        "statusMessage": "Checking feature scope and publication ownership"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/dist/factory-hook.js session-start",
                        "timeout": 5,
                        "statusMessage": "Re-injecting runner Iron Laws after compaction"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/dist/factory-hook.js feature-stop",
                        "timeout": 15,
                        "statusMessage": "Checking run state"
                    }
                ]
            }
        ]
    }
}
